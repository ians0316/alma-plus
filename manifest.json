{
  "manifest_version": 3,
  "name": "Alma+ Custom Tasks",
  "version": "2.15.4",
  "description": "Your own tasks, attached files, and notes inside Alma, styled like Alma, plus Google Calendar buttons.",
  "icons": {
    "16": "layout/icons/icon16.png",
    "32": "layout/icons/icon32.png",
    "48": "layout/icons/icon48.png",
    "128": "layout/icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "layout/icons/icon16.png",
      "32": "layout/icons/icon32.png",
      "48": "layout/icons/icon48.png",
      "128": "layout/icons/icon128.png"
    },
    "default_title": "Alma+ Custom Tasks",
    "default_popup": "settings/popup.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "nativeMessaging",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.getalma.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "layout/icons/google-calendar.svg",
        "layout/icons/seoul-academy.png"
      ],
      "matches": [
        "https://*.getalma.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.getalma.com/home/assignments*"
      ],
      "js": [
        "content/alma-plus.js",
        "files-and-notes/materials.js"
      ],
      "css": [
        "content/alma-plus.css",
        "files-and-notes/materials.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.getalma.com/home/class/*",
        "https://*.getalma.com/home/class-announcements/*"
      ],
      "js": [
        "content/alma-plus.js",
        "files-and-notes/materials.js",
        "gpa/class-tabs.js"
      ],
      "css": [
        "content/alma-plus.css",
        "files-and-notes/materials.css",
        "gpa/class-tabs.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.getalma.com/home",
        "https://*.getalma.com/home?*"
      ],
      "js": [
        "content/alma-plus.js",
        "files-and-notes/materials.js",
        "calendar/dashboard.js"
      ],
      "css": [
        "content/alma-plus.css",
        "files-and-notes/materials.css",
        "calendar/dashboard.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.getalma.com/*"
      ],
      "css": [
        "layout/rounded.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.getalma.com/calendar*"
      ],
      "js": [
        "content/alma-plus.js",
        "files-and-notes/materials.js",
        "calendar/official-calendar.js",
        "calendar/calendar.js"
      ],
      "css": [
        "content/alma-plus.css",
        "files-and-notes/materials.css",
        "calendar/calendar.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.getalma.com/*"
      ],
      "js": [
        "layout/sidebar.js",
        "layout/topbar.js"
      ],
      "run_at": "document_end",
      "css": [
        "layout/topbar.css"
      ]
    },
    {
      "matches": [
        "https://*.getalma.com/*"
      ],
      "js": [
        "gpa/gpa.js"
      ],
      "css": [
        "gpa/gpa.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "content/background.js"
  }
}
