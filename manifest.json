{
  "manifest_version": 3,
  "name": "Alma+ Custom Tasks",
  "version": "2.5.1",
  "description": "Your own tasks, attached files, and notes inside Alma, styled like Alma, plus Google Calendar buttons.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Alma+ Custom Tasks",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "nativeMessaging"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "google-calendar.svg",
        "icons/seoul-academy.png"
      ],
      "matches": [
        "https://*.getalma.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.getalma.com/home/assignments*"
      ],
      "js": [
        "alma-plus.js",
        "materials.js"
      ],
      "css": [
        "alma-plus.css",
        "materials.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.getalma.com/home/class/*"
      ],
      "js": [
        "alma-plus.js",
        "materials.js"
      ],
      "css": [
        "alma-plus.css",
        "materials.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.getalma.com/home",
        "https://*.getalma.com/home?*"
      ],
      "js": [
        "alma-plus.js",
        "materials.js",
        "dashboard.js"
      ],
      "css": [
        "alma-plus.css",
        "materials.css",
        "dashboard.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.getalma.com/*"
      ],
      "css": [
        "rounded.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.getalma.com/calendar*"
      ],
      "js": [
        "alma-plus.js",
        "materials.js",
        "official-calendar.js",
        "calendar.js"
      ],
      "css": [
        "alma-plus.css",
        "materials.css",
        "calendar.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
