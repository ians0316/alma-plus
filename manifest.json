{
  "manifest_version": 3,
  "name": "Alma+ Custom Tasks",
  "version": "2.0.0",
  "description": "Your own tasks, attached files, and notes inside Alma, styled like Alma, plus Google Calendar buttons.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Alma+ Custom Tasks",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "google-calendar.svg"
      ],
      "matches": [
        "https://*.getalma.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.getalma.com/home/assignments*"
      ],
      "js": [
        "alma-plus.js",
        "materials.js"
      ],
      "css": [
        "alma-plus.css",
        "materials.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.getalma.com/home/class/*"
      ],
      "js": [
        "alma-plus.js",
        "materials.js"
      ],
      "css": [
        "alma-plus.css",
        "materials.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
